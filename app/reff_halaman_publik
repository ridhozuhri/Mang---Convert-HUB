<script>
/* ─── State ───────────────────────────────────────────────── */
const pairs = {
  'USDT_IDR': { rate: 16100, fee: 0.5, feeType: 'percent', min: 10, max: 50000, rounding: 'floor', precision: 0 },
  'USDT_BCA': { rate: 16050, fee: 0.5, feeType: 'percent', min: 10, max: 50000, rounding: 'floor', precision: 0 },
  'USDT_USD': { rate: 0.998, fee: 0.3, feeType: 'percent', min: 10, max: 10000, rounding: 'floor', precision: 2 },
  'USDT_BTC': { rate: 0.0000163, fee: 1, feeType: 'percent', min: 10, max: 100000, rounding: 'floor', precision: 8 },
};

const assets = [
  { code: 'USDT', name: 'Tether USD', symbol: '₮', color: 'linear-gradient(135deg,#26a17b,#1a8064)', cat: 'stable' },
  { code: 'BTC',  name: 'Bitcoin',    symbol: '₿', color: 'linear-gradient(135deg,#f7931a,#e8841a)', cat: 'coin' },
  { code: 'ETH',  name: 'Ethereum',   symbol: 'Ξ', color: 'linear-gradient(135deg,#627eea,#4c63c7)', cat: 'coin' },
  { code: 'USD',  name: 'US Dollar',  symbol: '$', color: 'linear-gradient(135deg,#2c7a4b,#1e5c38)', cat: 'usd' },
  { code: 'IDR',  name: 'Rupiah',     symbol: 'Rp', color: 'linear-gradient(135deg,#dc2626,#b91c1c)', cat: 'bank' },
  { code: 'BCA',  name: 'Bank BCA',   symbol: 'BCA', color: 'linear-gradient(135deg,#005faf,#003d73)', cat: 'bank' },
  { code: 'GOPAY',name: 'GoPay',      symbol: 'GP', color: 'linear-gradient(135deg,#00aa5b,#007a41)', cat: 'bank' },
  { code: 'TSEL', name: 'Pulsa Telkomsel', symbol: 'T', color: 'linear-gradient(135deg,#ff0000,#cc0000)', cat: 'pulsa' },
];

let state = { from: 'USDT', to: 'IDR', amount: 100 };
let dropdownTarget = 'from';
let toastTimer = null;

/* ─── Kalkulasi ───────────────────────────────────────────── */
function getPair(from, to) {
  return pairs[`${from}_${to}`] || null;
}

function formatNum(n, decimals = 0) {
  if (n === null || n === undefined || isNaN(n)) return '—';
  return new Intl.NumberFormat('id-ID', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: Math.max(decimals, 8)
  }).format(n);
}

function recalculate() {
  const rawAmount = parseFloat(document.getElementById('amountInput').value) || 0;
  state.amount = rawAmount;
  const pair = getPair(state.from, state.to);

  const rv  = document.getElementById('receiveValue');
  const re  = document.getElementById('receiveEquiv');
  const sr  = document.getElementById('summaryRate');
  const sf  = document.getElementById('summaryFee');
  const smin = document.getElementById('summaryMin');
  const smax = document.getElementById('summaryMax');
  const pb  = document.getElementById('progressBar');
  const pl  = document.getElementById('progressLabel');

  if (!pair || rawAmount <= 0) {
    rv.textContent = '0';
    re.textContent = '';
    return;
  }

  // Warning
  if (rawAmount < pair.min) {
    rv.textContent = '⚠ Min ' + formatNum(pair.min) + ' ' + state.from;
    rv.className = 'receive-value loading';
    re.textContent = 'Jumlah terlalu kecil';
    return;
  }
  if (pair.max > 0 && rawAmount > pair.max) {
    rv.textContent = '⚠ Maks ' + formatNum(pair.max) + ' ' + state.from;
    rv.className = 'receive-value loading';
    re.textContent = 'Jumlah melebihi batas';
    return;
  }

  const gross = rawAmount * pair.rate;
  const fee   = pair.feeType === 'percent'
    ? rawAmount * (pair.fee / 100)
    : pair.fee;
  const feeIDR = fee * pair.rate;
  const net = gross - feeIDR;
  const rounded = pair.precision === 0
    ? Math.floor(net)
    : parseFloat(net.toFixed(pair.precision));

  rv.textContent = formatNum(rounded, pair.precision);
  rv.className = 'receive-value';
  re.textContent = '≈ $' + formatNum(rounded / 16100, 2) + ' USD est.';

  const rateDisplay = pair.rate >= 1 ? formatNum(pair.rate, 0) : pair.rate.toFixed(8);
  sr.textContent = rateDisplay;
  sf.textContent = formatNum(fee, pair.precision) + ' ' + state.from;
  smin.textContent = formatNum(pair.min) + ' ' + state.from;
  smax.textContent = formatNum(pair.max) + ' ' + state.from;

  // Progress bar
  const pct = Math.min((rawAmount / pair.max) * 100, 100);
  pb.style.width = Math.max(pct, 2) + '%';
  pl.textContent = formatNum(rawAmount) + ' / ' + formatNum(pair.max) + ' ' + state.from;
}

/* ─── Interactions ────────────────────────────────────────── */
function setAmount(val) {
  document.getElementById('amountInput').value = val;
  recalculate();
}

function selectCat(el) {
  document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

function selectAsset(el, code, cls, symbol) {
  document.querySelectorAll('.asset-list-item').forEach(i => i.classList.remove('selected'));
  el.classList.add('selected');
  state.to = code;
  recalculate();
}

function swapPair() {
  [state.from, state.to] = [state.to, state.from];
  recalculate();
  showToast('⇄', 'Pasangan ditukar');
}

/* ─── Dropdown ────────────────────────────────────────────── */
function openDropdown(target) {
  dropdownTarget = target;
  const overlay = document.getElementById('dropdownOverlay');
  const title   = document.getElementById('dropdownTitle');
  const search  = document.getElementById('dropdownSearch');
  title.textContent = target === 'from' ? 'Pilih Aset Kirim' : 'Pilih Aset Terima';
  renderDropdownList('');
  search.value = '';
  overlay.classList.add('open');
  setTimeout(() => search.focus(), 300);
}

function closeDropdown(e) {
  document.getElementById('dropdownOverlay').classList.remove('open');
}

function filterDropdown(q) {
  renderDropdownList(q.toLowerCase());
}

function renderDropdownList(q) {
  const list = document.getElementById('dropdownList');
  const filtered = assets.filter(a =>
    a.code.toLowerCase().includes(q) || a.name.toLowerCase().includes(q)
  );
  list.innerHTML = filtered.map(a => `
    <div class="dropdown-item ${a.code === (dropdownTarget === 'from' ? state.from : state.to) ? 'selected' : ''}"
         onclick="pickAsset('${a.code}','${a.name}','${a.symbol}','${a.color}')">
      <div class="dropdown-item-logo" style="background:${a.color}">${a.symbol}</div>
      <div class="dropdown-item-info">
        <div class="dropdown-item-code">${a.code}</div>
        <div class="dropdown-item-name">${a.name}</div>
      </div>
      ${a.code === (dropdownTarget === 'from' ? state.from : state.to) ? '<span class="dropdown-item-check">✓</span>' : ''}
    </div>
  `).join('');
}

function pickAsset(code, name, symbol, color) {
  if (dropdownTarget === 'from') {
    state.from = code;
    const logo = document.querySelector('.asset-logo');
    logo.className = 'asset-logo';
    logo.innerHTML = `<span class="asset-logo-img">${symbol}</span>`;
    logo.style.background = color;
    document.querySelector('.asset-code').innerHTML = `${code}`;
    document.querySelector('.asset-name').textContent = `${name}`;
    document.querySelector('.amount-suffix').textContent = code;
  } else {
    state.to = code;
  }
  closeDropdown();
  recalculate();
  showToast('✓', `${code} dipilih`);
}

/* ─── Toast ───────────────────────────────────────────────── */
function showToast(icon, msg) {
  const toast = document.getElementById('toast');
  document.getElementById('toastIcon').textContent = icon;
  document.getElementById('toastMsg').textContent  = msg;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2500);
}

/* ─── Nav tabs ────────────────────────────────────────────── */
document.querySelectorAll('.nav-tab').forEach(tab => {
  tab.addEventListener('click', function() {
    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
    this.classList.add('active');
  });
});

/* ─── Init ────────────────────────────────────────────────── */
recalculate();
</script>
